{
  "components": {
    "parameters": {
      "companyId": {
        "description": "The upstream company scope. It is the fleet's own Org/Tenant id through the one declared mapping — never a second tenancy.",
        "in": "path",
        "name": "companyId",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        },
        "x-company-mapping": "ao.paperclip.company/v1"
      }
    },
    "responses": {
      "400": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "``400`` — the request failed validation."
      },
      "401": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "``401`` — the caller identity is missing or invalid."
      },
      "403": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "``403`` — the caller is known but not allowed."
      },
      "404": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "``404`` — the resource is missing or outside the company scope."
      },
      "409": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "``409`` — the resource is owned, locked, or in conflict."
      },
      "422": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "``422`` — the request is well-formed but breaks a business rule."
      },
      "503": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "``503`` — the upstream database is unreachable."
      }
    },
