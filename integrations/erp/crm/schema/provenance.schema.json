{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kushin77.github.io/agent-orchestrator/integrations/erp/crm/schema/provenance.schema.json",
  "title": "ERP CRM harvest provenance (GR-10)",
  "description": "The machine-readable harvest record for the CRM-family lane: every harvested shape names its upstream project, version, licence, URL and date. The policy is a const so a record cannot quietly adopt a weaker one, and codeCopied is enforced by provenance.load, which refuses a true value by name.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "policy", "harvests"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9/-]*$"
    },
    "policy": {
      "type": "string",
      "const": "patterns-only-no-upstream-code"
    },
    "harvests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shape",
          "upstream",
          "upstreamVersion",
          "license",
          "codeCopied",
          "url",
          "harvestedAt"
        ],
        "properties": {
          "shape": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "upstream": {
            "type": "string",
            "minLength": 1
          },
          "upstreamVersion": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.+-]+$"
          },
          "codeCopied": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "minLength": 12,
            "pattern": "^https://"
          },
          "harvestedAt": {
            "type": "string",
            "minLength": 10
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
