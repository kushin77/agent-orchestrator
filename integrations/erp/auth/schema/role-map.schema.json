{
  "$id": "https://kushin77.example/agent-orchestrator/erp/auth/role-map.schema.json",
  "title": "ERP role map (ERP-08, issue #653)",
  "description": "The ERPNext role->permission map as data. The shape is intentionally narrow: a role grants (kind, action, permlevel) triples, and a kind wildcard is NOT expressible here because identity/rbac's '*' is a whole-segment wildcard that could not honour it.",
  "type": "object",
  "required": ["version", "kinds", "roles"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["kind", "action"],
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            "action": {"enum": ["*", "amend", "cancel", "create", "delete", "read", "submit", "write"]},
            "permlevel": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
