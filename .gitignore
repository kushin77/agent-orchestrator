# Local research/cannibalization scratch (never commit cloned fleet repos)
.research/

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Go
bin/

# Node
node_modules/

# Terraform state (never commit)
*.tfstate
*.tfstate.*
.terraform/
*.tfvars

# Dependency lock files are generated per-environment against the local
# provider cache; this repo's cache holds re-packed providers whose checksums
# differ from registry releases, so locks are not committed (regenerate at
# deploy time with `terraform init`).
.terraform.lock.hcl

# Verify-gate attestation artifacts (generated by make verify)
.verify/

# Claim locks are runtime state (the claim ledger itself is tracked evidence)
.board/locks/

# Fleet steering mailboxes are runtime state (schema + standing directive are tracked)
.fleet/inbox/
.fleet/outbox/
.fleet/sent/
.fleet/done/
.fleet/slog.jsonl
# Brain-rung surfaces (operator orders, replies) and rung liveness: runtime state.
.fleet/brain/
.fleet/*.heartbeat.json
.fleet/*.lock

# Local environment / secrets
.env
.env.*
