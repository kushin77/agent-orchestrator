{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ao.instructions.canonical/v1",
  "title": "Canonical instruction source (model-agnostic instruction layer)",
  "description": "The single source of truth for a governed instruction set. Layers are ordered most-governing first; managed layers are platform-governed and frozen to tenants. Global uniqueness of layer ids and rule ids is enforced by the loader (aoi.model).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "title", "summary", "layers"],
  "properties": {
    "schema": {
      "const": "ao.instructions.canonical/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "managed", "rules"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "managed": {
            "type": "boolean"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            }
          }
        }
      }
    }
  }
}
