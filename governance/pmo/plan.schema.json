{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kushin77/agent-orchestrator/governance/pmo/plan.schema.json",
  "title": "PMO enterprise project plan (issue #1648)",
  "description": "Every module/task across the fleet, organized by milestone and priority, converging on 'CRM + Asterisk voice operational'. Status is DERIVED LIVE from GitHub (status_source) and is never stored here as authority — this schema forbids a status/state field on a task for exactly that reason.",
  "type": "object",
  "required": ["goal", "milestones", "tasks"],
  "additionalProperties": false,
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "paperclip": {
      "type": "object",
      "description": "Projection of this plan as a Paperclip project (ADR-0014 join node). Owner personas from registry/personas/offices/cto/delivery-lifecycle.yaml.",
      "additionalProperties": false,
      "required": ["project_id", "project_name", "owner_persona", "milestone_owners"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "project_name": { "type": "string", "minLength": 1 },
        "owner_persona": { "type": "string", "minLength": 1 },
        "milestone_owners": {
          "type": "object",
          "description": "milestone id -> Paperclip agent persona that owns it",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "sync_adapter_status": {
          "enum": ["not-implemented", "read-only", "live"],
          "description": "Whether integrations/paperclip/adapters can push this plan to a live Paperclip instance. Gap tracked in issue #1649 while not-implemented."
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "order", "exit_criteria"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "exit_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["description", "command", "expect"],
              "additionalProperties": false,
              "properties": {
                "description": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 },
                "expect": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repo", "issue", "module", "milestone", "priority", "depends_on", "sme", "tier", "status_source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "issue": { "type": "integer", "minimum": 1 },
          "module": { "type": "string", "minLength": 1 },
          "milestone": { "type": "string", "pattern": "^M[0-9]+$" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sme": { "type": "string", "minLength": 1 },
          "tier": { "enum": ["L0", "L1", "L2"] },
          "status_source": { "const": "github" }
        }
      }
    }
  }
}
